platform :ios, '15.0'
use_frameworks!

target 'iosApp' do
  pod 'composeApp', :path => '../composeApp'
end

# Some Firebase transitive pods (gRPC, abseil, BoringSSL, etc.) still declare
# deployment targets older than what newer Xcode SDKs support building for.
# Force every Pods target to our real minimum so the build doesn't fail.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
